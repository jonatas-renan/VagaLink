# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# Onde achar: Supabase > Project Settings > API Keys.
# Use SOMENTE a chave publishable (sb_publishable_...) ou a antiga anon.
# NUNCA coloque a chave secret/service_role aqui.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXX
